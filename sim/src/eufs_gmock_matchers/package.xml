<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eufs_gmock_matchers</name>
  <version>0.0.0</version>
  <description>A library of gmock matchers for ROS messages.</description>

  <maintainer email="siliconlad@protonmail.com">Angus Stewart</maintainer>

  <license>MIT</license>

  <url type="website">http://eufs.co</url>
  <url type="repository">https://gitlab.com/eufs/infrastructure_group/eufs_gmock_matchers</url>
  <url type="bugtracker">https://gitlab.com/eufs/infrastructure_group/eufs_gmock_matchers/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eufs_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ament_cmake_gmock</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
